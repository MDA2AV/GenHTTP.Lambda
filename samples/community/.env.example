# Copy to .env and fill in what you use.

# Where the installation is reached - by you, your agent and your visitors.
LAMBDA_PUBLIC_URL=http://localhost:8080

# The password of the panel at /admin. Leave empty to switch the panel off.
LAMBDA_ADMIN_TOKEN=

# --- the build agent (docker compose --profile agent up -d) ---------------

# A secret the server and the agent share - any long random string:
#   openssl rand -hex 32
LAMBDA_AGENT_TOKEN=

# Where the server finds the agent; only with the agent profile.
#LAMBDA_AGENT_URL=http://agent:8401

# A token of your Claude subscription, made with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# The group of the docker socket on this machine: getent group docker | cut -d: -f3
DOCKER_GID=999
