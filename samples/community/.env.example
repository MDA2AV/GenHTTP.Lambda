# Copy to .env and fill in what you use.

# Where the installation is reached - by you, your agent and your visitors -
# such as https://lambda.example.com. The addresses of the apps are made from
# it; until it is set they read http://localhost:8080. Once it is set the
# server answers at that name only (and localhost), so set the name people
# really use.
LAMBDA_PUBLIC_URL=

# The password of the panel at /admin. Change it before anybody else can reach
# the server: whoever has it runs the installation. Empty switches the panel off.
LAMBDA_ADMIN_TOKEN=secure-password

# Once a day the installation sends a usage report - its version, the machine
# and counts over its apps, never its address nor what an app contains (see
# Telemetry in the README). false sends none.
#LAMBDA_USAGE_REPORTS=false

# --- the build agent (docker compose --profile agent up -d) ---------------

# A secret the server and the agent share - any long random string:
#   openssl rand -hex 32
LAMBDA_AGENT_TOKEN=

# Where the server finds the agent; only with the agent profile.
#LAMBDA_AGENT_URL=http://agent:8401

# What the builds sign in to Anthropic with - one of the two. A token of your
# Claude subscription, made with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# or an API key of your organization's account at Anthropic, billed by the
# token. Where both are set, the token is used.
#LAMBDA_AGENT_API_KEY=

# The password for the models the panel's Build agent section puts behind one
# (Fable, unless you decide otherwise). Without it they are not offered.
#LAMBDA_AGENT_PASSWORD=

# Whether a build may read the pages of the sites a request names ("look at
# myoldhomepage.com"): GET and HEAD, public addresses only, those sites only.
# false switches it off.
#LAMBDA_AGENT_FETCH=false

# The group of the docker socket on this machine: getent group docker | cut -d: -f3
DOCKER_GID=999

# The password of the PostgreSQL server, where docker-compose.postgres.yml is
# laid over the rest: openssl rand -hex 24
#POSTGRES_PASSWORD=
