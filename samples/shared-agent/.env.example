# Copy to .env and fill in what you use.

# --- team-a, on http://localhost:8080 ---------------------------------------

# Where team-a is reached; the addresses of its apps are made from it.
#TEAM_A_PUBLIC_URL=https://team-a.example.com
TEAM_A_ADMIN_TOKEN=secure-password
# The secret team-a and the runner share, and how the runner tells team-a's
# builds from team-b's - a long random string, different for each:
#   openssl rand -hex 32
TEAM_A_AGENT_TOKEN=
#TEAM_A_AGENT_PASSWORD=

# --- team-b, on http://localhost:8081 ---------------------------------------

#TEAM_B_PUBLIC_URL=https://team-b.example.com
TEAM_B_ADMIN_TOKEN=secure-password
TEAM_B_AGENT_TOKEN=
#TEAM_B_AGENT_PASSWORD=

# --- the build agent, shared ------------------------------------------------

# What the builds of both sign in to Anthropic with - one of the two. A token
# of your Claude subscription, made with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# or an API key of your organization's account at Anthropic, billed by the
# token. Where both are set, the token is used.
#LAMBDA_AGENT_API_KEY=

# How many builds run at once, of both installations together: 2 GB and one
# and a half cores each while they run.
#LAMBDA_AGENT_CONCURRENCY=2

# Whether a build may read the pages of the sites a request names. false
# switches it off for both.
#LAMBDA_AGENT_FETCH=false

# The group of the docker socket on this machine: getent group docker | cut -d: -f3
DOCKER_GID=999

# Once a day each installation sends a usage report (see Telemetry in the
# README). false sends none.
#LAMBDA_USAGE_REPORTS=false
