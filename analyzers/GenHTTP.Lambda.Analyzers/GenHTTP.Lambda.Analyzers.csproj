<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The repository's own rules, checked as every project of it compiles
        (Directory.Build.props hands it to them): one top-level type per file,
        named after it. Not part of the platform and never shipped.
    -->

    <PropertyGroup>

        <!-- what every compiler loads an analyzer as -->
        <TargetFramework>netstandard2.0</TargetFramework>

        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

        <!-- the rules ship with the repository, not as a package, so there is no release to track them for -->
        <NoWarn>$(NoWarn);RS2008</NoWarn>

    </PropertyGroup>

    <ItemGroup>

        <!--
            Older than the compiler of the SDK in global.json on purpose: a
            compiler loads an analyzer built against its own Roslyn or an
            older one, never a newer (CS8032). 5.12.0, which the platform
            compiles lambdas with, is the SDK's own and would leave no room.
        -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" PrivateAssets="all" />

    </ItemGroup>

</Project>
