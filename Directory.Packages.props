<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <ItemGroup>

        <PackageVersion Include="GenHTTP.Full.Ioxide" Version="11.3.0" />
        <PackageVersion Include="GenHTTP.Engine.Kestrel" Version="11.3.0" />

        <!-- what the contracts of the integrations serve files as, without the rest of the framework -->
        <PackageVersion Include="GenHTTP.Api" Version="11.3.0" />
        <PackageVersion Include="GenHTTP.Modules.IO" Version="11.3.0" />

        <!-- the tests' client and host; no longer carried by GenHTTP.Full.Ioxide since 11.1 -->
        <PackageVersion Include="GenHTTP.Testing" Version="11.3.0" />

        <!-- serves every lambda as a git repository, see Services/Git -->
        <PackageVersion Include="GenHTTP.Modules.Git" Version="0.1.1" />

        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />

        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />

        <!--
            PostgreSQL, for installations that keep their data there (see
            GenHTTP.Lambda.Integrations.PostgreSql). The provider for EF Core 11
            is a release candidate as of writing, pinned to the RC of EF Core it
            was built against; the integration takes EF Core's 11.0.0 instead
            and says so (NU1608). Move to 11.0.0 once it is released.
        -->
        <PackageVersion Include="Npgsql" Version="10.0.3" />
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0" />

        <PackageVersion Include="Evolve" Version="3.2.0" />

        <!-- refuses, at compile time, what the server must not call: see BannedSymbols.txt -->
        <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />

        <!-- reads the MaxMind DB format, which is how the free DB-IP databases
             ship: a memory mapped search trie rather than a table, so a
             hundred and fifty megabyte file costs page cache and not heap -->
        <PackageVersion Include="MaxMind.Db" Version="5.2.0" />

        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageVersion Include="MSTest" Version="4.5.3" />

    </ItemGroup>

</Project>
