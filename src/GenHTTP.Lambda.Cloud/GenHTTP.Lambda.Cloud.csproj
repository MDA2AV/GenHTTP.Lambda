<Project Sdk="Microsoft.NET.Sdk">

    <!-- genhttp.dev: the components, and the pages of the site that are this host's own -->
    <PropertyGroup>

        <OutputType>Exe</OutputType>

        <RootNamespace>GenHTTP.Lambda.Cloud</RootNamespace>
        <AssemblyName>GenHTTP.Lambda.Cloud</AssemblyName>

        <ServerGarbageCollection>true</ServerGarbageCollection>

    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../GenHTTP.Lambda.Core/GenHTTP.Lambda.Core.csproj" />
        <ProjectReference Include="../GenHTTP.Lambda.Web/GenHTTP.Lambda.Web.csproj" />
        <ProjectReference Include="../GenHTTP.Lambda.Execution/GenHTTP.Lambda.Execution.csproj" />
        <ProjectReference Include="../GenHTTP.Lambda.Api/GenHTTP.Lambda.Api.csproj" />
        <ProjectReference Include="../GenHTTP.Lambda.Mcp/GenHTTP.Lambda.Mcp.csproj" />
        <ProjectReference Include="../GenHTTP.Lambda.Server/GenHTTP.Lambda.Server.csproj" />
        <ProjectReference Include="../GenHTTP.Lambda.Editing/GenHTTP.Lambda.Editing.csproj" />
        <ProjectReference Include="../GenHTTP.Lambda.Administration/GenHTTP.Lambda.Administration.csproj" />
        <ProjectReference Include="../GenHTTP.Lambda.Sources/GenHTTP.Lambda.Sources.csproj" />
    </ItemGroup>

    <ItemGroup>

        <!-- the sources of the site's frontend and what npm builds them into are no part of the assembly -->
        <None Remove="Frontend/**;bundle/**" />

        <!-- the site's bundle, which "npm run build" puts into bundle/ (see Website) -->
        <Content Include="bundle/**" Link="bundles/cloud/%(RecursiveDir)%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    </ItemGroup>

</Project>
