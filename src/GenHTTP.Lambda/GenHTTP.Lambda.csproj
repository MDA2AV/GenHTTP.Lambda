<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>

        <OutputType>Exe</OutputType>

        <RootNamespace>GenHTTP.Lambda</RootNamespace>
        <AssemblyName>GenHTTP.Lambda</AssemblyName>

        <ServerGarbageCollection>true</ServerGarbageCollection>

        <!--
            .NET 11 can compile async methods into the runtime itself rather
            than into a state machine class per method. A server is almost
            entirely await, so this is where its allocation goes.

            Still a preview feature, hence the switch: build with
            -p:RuntimeAsync=false to get the state machines back, which is the
            first thing to try if something asynchronous starts misbehaving.
        -->
        <RuntimeAsync Condition="'$(RuntimeAsync)' == ''">true</RuntimeAsync>

    </PropertyGroup>

    <PropertyGroup Condition="'$(RuntimeAsync)' == 'true'">
        <Features>$(Features);runtime-async=on</Features>
    </PropertyGroup>

    <ItemGroup>

        <PackageReference Include="GenHTTP.Full.Ioxide" />

        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />

        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />

        <PackageReference Include="Evolve" />

    </ItemGroup>

    <ItemGroup>

        <!-- the frontend is built into wwwroot by "npm run build" in src/Frontend -->
        <None Remove="wwwroot/**" />
        <Content Include="wwwroot/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Data/Migrations/*.sql" />
        <!-- WithCulture is required: MSBuild would read the "cs" in "Template.cs.txt" as Czech -->
        <EmbeddedResource Include="Resources/Templates/*.cs.txt" WithCulture="false" />
        <!-- an example may ship a page as well as the code that serves it -->
        <EmbeddedResource Include="Resources/Templates/*.html.txt" WithCulture="false" />
        <EmbeddedResource Include="Resources/Templates/*.js.txt" WithCulture="false" />
        <EmbeddedResource Include="Resources/Templates/*.css.txt" WithCulture="false" />
    </ItemGroup>

</Project>
